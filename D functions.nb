    RowBox[{"x_", ",", "xb_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"dU", "[", 
     RowBox[{"D1111", "[", 
      RowBox[{"x", ",", "xb"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
