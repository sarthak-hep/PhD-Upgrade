d64ecf454208"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"ftreeCand", "[", 
     RowBox[{"\[Chi]", ",", "\[Chi]b"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"norm", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["\[Pi]", "4"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Chi]", "-", "\[Chi]b"}], ")"}], "7"]}]], "48", " ", "n", " ",
     "\[Chi]", " ", "\[Chi]b"}]}], " ", ";"}], "\n", 
 RowBox[{
  RowBox[{"core", "=", 
   RowBox[{"Cancel", "[", 
    RowBox[{"expr", "/", "norm"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "LChiP", ",", "LChiM", ",", "LOneP", ",", "LOneM", ",", "Li2P", ",", 
    "Li2M"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"toBasis", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"\[Chi]", " ", "\[Chi]b"}], "]"}], "->", "LChiP"}], ",", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"\[Chi]", "/", "\[Chi]b"}], "]"}], "->", "LChiM"}], ",", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Chi]", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"\[Chi]b", "-", "1"}], ")"}]}], "]"}], "->", "LOneP"}], ",", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Chi]"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Chi]b"}], ")"}]}], "]"}], "->", "LOneP"}], ",", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Chi]", "-", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"\[Chi]b", "-", "1"}], ")"}]}], "]"}], "->", "LOneM"}], ",", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Chi]"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Chi]b"}], ")"}]}], "]"}], "->", "LOneM"}], ",", 
     RowBox[{
      RowBox[{"Log", "[", "\[Chi]", "]"}], "->", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"LChiP", "+", "LChiM"}], ")"}], "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{"Log", "[", "\[Chi]b", "]"}], "->", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"LChiP", "-", "LChiM"}], ")"}], "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "\[Chi]"}], "]"}], "->", 
