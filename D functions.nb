Cell[CellGroupData[{
Cell["\<\
Definitions of D functions and Coordinate transformation from {U,V} to \
{\[Chi], \[Chi]b}\
\>", "Section",
 CellChangeTimes->{{3.9950020874544106`*^9, 
  3.99500210801186*^9}},ExpressionUUID->"85995b83-2669-cd48-a317-\
70da77a61397"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Chi]", ",", "\[Chi]b"}], "}"}], ",", "Reals"}], "]"}], "&&", 
    RowBox[{"0", "<", "\[Chi]", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Chi]b", "<", "1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"U", "[", 
    RowBox[{"\[Chi]_", ",", "\[Chi]b_"}], "]"}], ":=", 
   RowBox[{"\[Chi]", " ", "\[Chi]b"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"\[Chi]_", ",", "\[Chi]b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "\[Chi]"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "\[Chi]b"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dU", "[", "f_", "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Chi]", "-", "1"}], ")"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{"f", ",", "\[Chi]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Chi]b"}], ")"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{"f", ",", "\[Chi]b"}], "]"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"\[Chi]", "-", "\[Chi]b"}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dV", "[", "f_", "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Chi]"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{"f", ",", "\[Chi]"}], "]"}]}], "+", 
       RowBox[{"\[Chi]b", " ", 
        RowBox[{"D", "[", 
         RowBox[{"f", ",", "\[Chi]b"}], "]"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"\[Chi]", "-", "\[Chi]b"}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]", "[", 
    RowBox[{"x_", ",", "xb_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"(", 
      RowBox[{"x", "-", "xb"}], ")"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"x", " ", "xb"}], "]"}], 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"1", "-", "x"}], 
         RowBox[{"1", "-", "xb"}]], "]"}]}], "+", " ", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"PolyLog", "[", 
          RowBox[{"2", ",", "x"}], "]"}], "-", 
         RowBox[{"PolyLog", "[", 
          RowBox[{"2", ",", "xb"}], "]"}]}], ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"D1111", "[", 
    RowBox[{"x_", ",", "xb_"}], "]"}], ":=", 
