 RowBox[{
  RowBox[{
   RowBox[{"zeroRules", "[", 
    RowBox[{"variable_", ",", "orientation_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", "=", 
       RowBox[{"orientation", " ", "2", " ", "Pi", " ", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"branchLogZero", "[", "variable", "]"}], ":>", 
        RowBox[{
         RowBox[{"branchLogZero", "[", "variable", "]"}], "+", "k"}]}], ",", 
       RowBox[{
        RowBox[{"branchLiOneMinus", "[", 
         RowBox[{"n_Integer", ",", "variable"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"branchLiOneMinus", "[", 
          RowBox[{"n", ",", "variable"}], "]"}], "-", 
         RowBox[{"k", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"branchLogOne", "[", "variable", "]"}], "^", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}], "/", 
           RowBox[{"Factorial", "[", 
            RowBox[{"n", "-", "1"}], "]"}]}]}]}]}], ",", 
       RowBox[{
        RowBox[{"branchNielsenOneMinus", "[", 
         RowBox[{"1", ",", "2", ",", "variable"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"branchNielsenOneMinus", "[", 
          RowBox[{"1", ",", "2", ",", "variable"}], "]"}], "+", 
         RowBox[{"k", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Zeta", "[", "2", "]"}], "-", 
            RowBox[{"branchLiOneMinus", "[", 
             RowBox[{"2", ",", "variable"}], "]"}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"k", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"branchLogOne", "[", "variable", "]"}], "/", "2"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"branchNielsenOneMinus", "[", 
         RowBox[{"2", ",", "2", ",", "variable"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"branchNielsenOneMinus", "[", 
          RowBox[{"2", ",", "2", ",", "variable"}], "]"}], "+", 
         RowBox[{"k", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Zeta", "[", "3", "]"}], "+", 
            RowBox[{
             RowBox[{"Zeta", "[", "2", "]"}], " ", 
             RowBox[{"branchLogOne", "[", "variable", "]"}]}], "-", 
            RowBox[{"branchLiOneMinus", "[", 
             RowBox[{"3", ",", "variable"}], "]"}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"k", "^", "2"}], " ", 
          RowBox[{
           RowBox[{
            RowBox[{"branchLogOne", "[", "variable", "]"}], "^", "2"}], "/", 
           "4"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"branchNielsenOneMinus", "[", 
         RowBox[{"1", ",", "3", ",", "variable"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"branchNielsenOneMinus", "[", 
          RowBox[{"1", ",", "3", ",", "variable"}], "]"}], "+", 
         RowBox[{"k", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Zeta", "[", "3", "]"}], "-", 
            RowBox[{"branchNielsenOneMinus", "[", 
             RowBox[{"1", ",", "2", ",", "variable"}], "]"}]}], ")"}]}], "+", 
