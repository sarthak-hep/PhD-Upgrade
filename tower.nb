        RowBox[{"[", "1", "]"}], "]"}], ">=", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"antiPolynomial", "[", 
    RowBox[{"coefficient_", ",", "x_", ",", "xb_", ",", 
     RowBox[{"maximumIndex_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"pair", ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i", "=", 
            RowBox[{"pair", "[", 
