  3.9860354516027126`*^9}},ExpressionUUID->"e2488ad1-4221-bf4f-a026-\
794d538da369"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chso4", "[", 
    RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"a", "+", "1"}], ")"}], "/", "2"}], ")"}]}], "-", 
          RowBox[{"x", "^", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "+", "1"}], ")"}], "/", "2"}], ")"}]}]}]}], "}"}],
         "}"}], "]"}], "/", 
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], "-", 
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], ")"}]}]}], "}"}], "}"}], "]"}]}],
      "*", 
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"y", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"b", "+", "1"}], ")"}], "/", "2"}], ")"}]}], "-", 
          RowBox[{"y", "^", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"b", "+", "1"}], ")"}], "/", "2"}], ")"}]}]}]}], "}"}],
         "}"}], "]"}], "/", 
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"y", "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], "-", 
          RowBox[{"y", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], ")"}]}]}], "}"}], "}"}], 
       "]"}]}]}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dimso4", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"chso4", "[", 
      RowBox[{"x", ",", "y", ",", "a", ",", "b"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "->", "1"}], ",", 
       RowBox[{"y", "->", "1"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9860353708439674`*^9, 3.986035406659605*^9}, {
