Cell[CellGroupData[{

Cell["Definitions", "Subsection",
 CellChangeTimes->{{3.986049879299505*^9, 
  3.9860498807818375`*^9}},ExpressionUUID->"3674a63a-7437-644a-9e43-\
d3be84df61d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"branchsp4tosu2su2", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"coeff", "[", 
        RowBox[{"a", ",", "b", ",", "p", ",", "q"}], "]"}], 
       RowBox[{"su2", "[", 
        RowBox[{"x", ",", 
         FractionBox["p", "2"]}], "]"}], 
       RowBox[{"su2", "[", 
        RowBox[{"y", ",", 
         FractionBox["q", "2"]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", "0", ",", 
        RowBox[{"a", "+", "b"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", "0", ",", 
        RowBox[{"a", "+", "b"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"SeriesCoefficient", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"chsp4", "[", 
                 RowBox[{"x", ",", "y", ",", "a", ",", "b"}], "]"}], "-", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"coeff", "[", 
                    RowBox[{"a", ",", "b", ",", "p", ",", "q"}], "]"}], 
                   RowBox[{"chsl2", "[", 
                    RowBox[{"x", ",", "p"}], "]"}], 
                   RowBox[{"chsl2", "[", 
                    RowBox[{"y", ",", "q"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"p", ",", "0", ",", 
                    RowBox[{"a", "+", "b"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"q", ",", "0", ",", 
                    RowBox[{"a", "+", "b"}]}], "}"}]}], "]"}]}], ")"}], 
              SuperscriptBox["x", 
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"a", "+", "b"}], ")"}]}]], 
              SuperscriptBox["y", 
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"a", "+", "b"}], ")"}]}]]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "i"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "0", ",", "j"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"a", "+", "b"}], ")"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"a", "+", "b"}], ")"}]}]}], "}"}]}], "]"}], "]"}], "==",
         "0"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9860482295612698`*^9, 3.9860483390194283`*^9}, {
  3.9860483705084133`*^9, 3.986048448940092*^9}, {3.9860484917147007`*^9, 
