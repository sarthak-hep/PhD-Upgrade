Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"branchsu4tosp4", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"coeff", "[", 
        RowBox[{"a", ",", "b", ",", "c", ",", "p", ",", "q"}], "]"}], 
       RowBox[{"sp4", "[", 
        RowBox[{"t1", ",", "t2", ",", "p", ",", "q"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", "0", ",", 
        RowBox[{"a", "+", "b", "+", "c"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", "0", ",", 
        RowBox[{"a", "+", "b", "+", "c"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"SeriesCoefficient", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"chsu4", "[", 
                 RowBox[{"t1", ",", "t2", ",", 
                  FractionBox["1", "t1"], ",", 
                  FractionBox["1", "t2"], ",", "a", ",", "b", ",", "c"}], 
                 "]"}], "-", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"coeff", "[", 
                    RowBox[{"a", ",", "b", ",", "c", ",", "p", ",", "q"}], 
                    "]"}], 
                   RowBox[{"chsp4", "[", 
                    RowBox[{"t1", ",", "t2", ",", "p", ",", "q"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"p", ",", "0", ",", 
                    RowBox[{"a", "+", "b", "+", "c"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"q", ",", "0", ",", 
                    RowBox[{"a", "+", "b", "+", "c"}]}], "}"}]}], "]"}]}], 
               ")"}], 
              SuperscriptBox["t1", 
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]], 
              SuperscriptBox["t2", 
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]]}], ",", 
             RowBox[{"{", 
              RowBox[{"t1", ",", "0", ",", "i"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"t2", ",", "0", ",", "j"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]}], "}"}]}], "]"}], 
         "]"}], "==", "0"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "}"}]}]}], ";"}]], "Input",
