  3.9780066532077255`*^9}},ExpressionUUID->"b04b6c17-93fe-064b-9570-\
fa765c4bb337"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chsp4", "[", 
    RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Det", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["x", 
            RowBox[{"a", "+", "b", "+", "2"}]], "-", 
           SuperscriptBox["x", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"a", "+", "b", "+", "2"}], ")"}]}]]}], ",", 
          RowBox[{
           SuperscriptBox["x", 
            RowBox[{"b", "+", "1"}]], "-", 
           SuperscriptBox["x", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"b", "+", "1"}], ")"}]}]]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["y", 
            RowBox[{"a", "+", "b", "+", "2"}]], "-", 
           SuperscriptBox["y", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"a", "+", "b", "+", "2"}], ")"}]}]]}], ",", 
          RowBox[{
           SuperscriptBox["y", 
            RowBox[{"(", 
             RowBox[{"b", "+", "1"}], ")"}]], "-", 
           SuperscriptBox["y", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"b", "+", "1"}], ")"}]}]]}]}], "}"}]}], "}"}], "]"}], "/", 
     RowBox[{"Det", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["x", "2"], "-", 
           SuperscriptBox["x", 
            RowBox[{"-", "2"}]]}], ",", 
          RowBox[{"x", "-", 
           SuperscriptBox["x", 
            RowBox[{"-", "1"}]]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["y", "2"], "-", 
           SuperscriptBox["y", 
            RowBox[{"-", "2"}]]}], ",", 
          RowBox[{"y", "-", 
           SuperscriptBox["y", 
            RowBox[{"-", "1"}]]}]}], "}"}]}], "}"}], "]"}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dimsp4", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"chsp4", "[", 
      RowBox[{"x", ",", "y", ",", "a", ",", "b"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "->", "1"}], ",", 
       RowBox[{"y", "->", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Sp4Bounds", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c_", ",", "d_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", "=", 
        RowBox[{"a", "+", "c"}]}], ",", 
       RowBox[{"B", "=", 
        RowBox[{"b", "+", "d"}]}], ",", "pMax", ",", "qMax"}], "}"}], ",", 
     RowBox[{
      RowBox[{"pMax", "=", 
       RowBox[{"A", "+", 
        RowBox[{"2", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"B", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qMax", "=", 
       RowBox[{"B", "+", 
        RowBox[{"Floor", "[", 
         RowBox[{"A", "/", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"pMax", ",", "qMax"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sp4productexpand", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", "b_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c_", ",", "d_"}], "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"coeff", "[", 
        RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
        "]"}], 
       RowBox[{"sp4", "[", 
        RowBox[{"x", ",", "y", ",", "e", ",", "f"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"e", ",", "0", ",", 
        RowBox[{"a", "+", "b", "+", "c", "+", "d"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"f", ",", "0", ",", 
        RowBox[{"a", "+", "b", "+", "c", "+", "d"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Solve", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"SeriesCoefficient", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"chsp4", "[", 
                  RowBox[{"x", ",", "y", ",", "a", ",", "b"}], "]"}], 
                 RowBox[{"chsp4", "[", 
                  RowBox[{"x", ",", "y", ",", "c", ",", "d"}], "]"}]}], "-", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"coeff", "[", 
                    RowBox[{
                    "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
                    "]"}], 
                   RowBox[{"chsp4", "[", 
                    RowBox[{"x", ",", "y", ",", "e", ",", "f"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"e", ",", "0", ",", 
                    RowBox[{"a", "+", "b", "+", "c", "+", "d"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"f", ",", "0", ",", 
                    RowBox[{"a", "+", "b", "+", "c", "+", "d"}]}], "}"}]}], 
                 "]"}]}], ")"}], 
              SuperscriptBox["x", 
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}]}]], 
              SuperscriptBox["y", 
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}]}]]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "i"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "0", ",", "j"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}]}]}], "}"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"a", "+", "b", "+", "c", "+", "d"}], ")"}]}]}], 
            "}"}]}], "]"}], "==", "0"}], "]"}], "]"}], "}"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9779914501430874`*^9, 3.9779916050264263`*^9}, {
