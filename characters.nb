Cell[CellGroupData[{

Cell["Definitions", "Subsection",
 CellChangeTimes->{{3.986035504787979*^9, 
  3.9860355061535683`*^9}},ExpressionUUID->"082f51f7-3d54-7243-a015-\
2c5a0ab5700d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chsl2", "[", 
    RowBox[{"z_", ",", "a_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{"a", "+", "1"}]], "-", 
       SuperscriptBox["z", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"a", "+", "1"}], ")"}]}]]}], ")"}], 
     RowBox[{"z", "-", 
      SuperscriptBox["z", 
       RowBox[{"-", "1"}]]}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dimsl2", "[", "a_", "]"}], ":=", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"chsl2", "[", 
      RowBox[{"z", ",", "a"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", "->", "1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sl2productexpand", "[", 
    RowBox[{
     RowBox[{"{", "a_", "}"}], ",", 
     RowBox[{"{", "b_", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"coeff", "[", 
        RowBox[{"a", ",", "b", ",", "c"}], "]"}], 
       RowBox[{"sl2", "[", 
        RowBox[{"x", ",", "c"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"c", ",", "0", ",", 
        RowBox[{"(", 
         RowBox[{"a", "+", "b"}], ")"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Solve", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"SeriesCoefficient", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"chsl2", "[", 
                  RowBox[{"x", ",", "a"}], "]"}], 
                 RowBox[{"chsl2", "[", 
                  RowBox[{"x", ",", "b"}], "]"}]}], "-", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"coeff", "[", 
                    RowBox[{"a", ",", "b", ",", "c"}], "]"}], 
                   RowBox[{"chsl2", "[", 
                    RowBox[{"x", ",", "c"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"c", ",", "0", ",", 
                    RowBox[{"a", "+", "b"}]}], "}"}]}], "]"}]}], ")"}], 
              SuperscriptBox["x", 
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"a", "+", "b"}], ")"}]}]]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "i"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"a", "+", "b"}], ")"}]}]}], "}"}]}], "]"}], "==", 
         "0"}], "]"}], "]"}], "}"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9860354819392796`*^9, 3.9860354962293396`*^9}, {
  3.986053982766632*^9, 3.986054101594702*^9}, {3.986054172020382*^9, 
  3.9860542098805504`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"b6524acd-afa6-2c4a-bf7c-1da3ef94797b"],

