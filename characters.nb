Cell[CellGroupData[{

Cell["Definitions", "Subsection",
 CellChangeTimes->{{3.9860321182533092`*^9, 
  3.9860321196451797`*^9}},ExpressionUUID->"e1613951-0c02-9740-bf3c-\
8c6d335d5762"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chso5", "[", 
    RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Det", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["x", 
           RowBox[{"a", "+", 
            RowBox[{"b", "/", "2"}], "+", 
            RowBox[{"3", "/", "2"}]}]], "-", 
          SuperscriptBox["x", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"a", "+", 
              RowBox[{"b", "/", "2"}], "+", 
              RowBox[{"3", "/", "2"}]}], ")"}]}]]}], ",", 
         RowBox[{
          SuperscriptBox["x", 
           RowBox[{
            RowBox[{"b", "/", "2"}], "+", 
            RowBox[{"1", "/", "2"}]}]], "-", 
          SuperscriptBox["x", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"b", "/", "2"}], "+", 
              RowBox[{"1", "/", "2"}]}], ")"}]}]]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["y", 
           RowBox[{"a", "+", 
            RowBox[{"b", "/", "2"}], "+", 
            RowBox[{"3", "/", "2"}]}]], "-", 
          SuperscriptBox["y", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"a", "+", 
              RowBox[{"b", "/", "2"}], "+", 
              RowBox[{"3", "/", "2"}]}], ")"}]}]]}], ",", 
         RowBox[{
          SuperscriptBox["y", 
           RowBox[{
            RowBox[{"b", "/", "2"}], "+", 
            RowBox[{"1", "/", "2"}]}]], "-", 
          SuperscriptBox["y", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"b", "/", "2"}], "+", 
              RowBox[{"1", "/", "2"}]}], ")"}]}]]}]}], "}"}]}], "}"}], "]"}], 
    "/", 
    RowBox[{"Det", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["x", 
           RowBox[{"3", "/", "2"}]], "-", 
          SuperscriptBox["x", 
           RowBox[{
            RowBox[{"-", "3"}], "/", "2"}]]}], ",", 
         RowBox[{
          SuperscriptBox["x", 
           RowBox[{"1", "/", "2"}]], "-", 
          SuperscriptBox["x", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}]]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["y", 
           RowBox[{"3", "/", "2"}]], "-", 
          SuperscriptBox["y", 
           RowBox[{
            RowBox[{"-", "3"}], "/", "2"}]]}], ",", 
         RowBox[{
          SuperscriptBox["y", 
           RowBox[{"1", "/", "2"}]], "-", 
          SuperscriptBox["y", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}]]}]}], "}"}]}], "}"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dimso5", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
