Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coefficientsToZero", "[", 
    RowBox[{"maximumIndex_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a3", "@@", "#"}], ",", 
         RowBox[{"a4", "@@", "#"}], ",", 
         RowBox[{"a5", "@@", "#"}]}], "}"}], "&"}], ")"}], "/@", 
     RowBox[{"symPairs", "[", "maximumIndex", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroRules", "[", 
    RowBox[{"maximumIndex_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"coefficientsToZero", "[", "maximumIndex", "]"}], "->", "0"}], 
    "]"}]}], ";"}]}], "Input",
