Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coefficientsToZero", "[", 
    RowBox[{"maximumIndex_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a3", "@@", "#"}], ",", 
         RowBox[{"a4", "@@", "#"}], ",", 
         RowBox[{"a5", "@@", "#"}]}], "}"}], "&"}], ")"}], "/@", 
     RowBox[{"symPairs", "[", "maximumIndex", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroRules", "[", 
    RowBox[{"maximumIndex_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"coefficientsToZero", "[", "maximumIndex", "]"}], "->", "0"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99804043636615*^9, 3.9980404916546535`*^9}, {
  3.9980407262485905`*^9, 3.998040735741373*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"5cd7165b-f247-0645-8fde-aed8c0f6a048"]
}, Open  ]],

