Cell[BoxData[
 RowBox[{
  RowBox[{"reg", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Thread", "[", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"CoefficientList", "[", 
           RowBox[{
            RowBox[{"Expand", "@", 
             RowBox[{"Numerator", "@", 
              RowBox[{"Together", "[", 
               RowBox[{
                RowBox[{"Coefficient", "[", 
                 RowBox[{
                  RowBox[{"Normal", "[", 
                   RowBox[{"Series", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Ftree", "[", 
                    RowBox[{
                    RowBox[{"z", "+", 
                    RowBox[{"d", "/", "2"}]}], ",", 
                    RowBox[{"z", "-", 
                    RowBox[{"d", "/", "2"}]}]}], "]"}], "/.", 
                    RowBox[{"zeroRules", "[", "7", "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"d", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], 
                  ",", "d", ",", "i"}], "]"}], "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Log", "[", 
                    RowBox[{"z", "^", "2"}], "]"}], "->", 
                   RowBox[{"2", " ", "lz"}]}], ",", 
                  RowBox[{
                   RowBox[{"Log", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "z"}], ")"}], "^", "2"}], "]"}], 
                   "->", 
                   RowBox[{"2", " ", "l1z"}]}], ",", 
                  RowBox[{
                   RowBox[{"Log", "[", "z", "]"}], "->", "lz"}], ",", 
                  RowBox[{
                   RowBox[{"Log", "[", 
                    RowBox[{"1", "-", "z"}], "]"}], "->", "l1z"}]}], "}"}]}], 
               "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"lz", ",", "l1z", ",", "z"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "6"}], "}"}]}], "]"}], "]"}], ",", 
       "0"}], "]"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.998066462708521*^9},
 CellLabel->"In[92]:=",ExpressionUUID->"091d3100-169c-374e-8e5b-1ff566d45550"]
}, Open  ]],

