 RowBox[{
  RowBox[{"ope2", "=", 
   RowBox[{
    RowBox[{"Coefficient", "[", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cancel", "[", 
          RowBox[{
           RowBox[{"SeriesCoefficient", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Coefficient", "[", 
                RowBox[{
                 RowBox[{"Expand", "[", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Ftree", "[", 
                    RowBox[{"\[Chi]", ",", "\[Chi]b"}], "]"}], "/.", 
                    "\[IndentingNewLine]", 
                    RowBox[{"zeroRules", "[", "7", "]"}]}], ")"}], "/.", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Log", "[", 
                    RowBox[{"\[Chi]", " ", "\[Chi]b"}], "]"}], "->", "l"}]}], 
                  "]"}], ",", "l", ",", "1"}], "]"}], ")"}], "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Chi]", "->", 
                 RowBox[{"s", " ", "x"}]}], ",", 
                RowBox[{"\[Chi]b", "->", 
                 RowBox[{"s", " ", "y"}]}]}], "}"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "0", ",", "9"}], "}"}]}], "]"}], "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "y"}], ")"}], "^", "7"}]}], "]"}], "//", 
         "Expand"}], ",", "x", ",", "1"}], "]"}], ",", "y", ",", "1"}], "]"}],
     "//", "Simplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998066551747364*^9, 3.9980665555252953`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"ce51c7eb-8654-3e4b-a90a-c59792048845"]
}, Open  ]]
}, Open  ]],

