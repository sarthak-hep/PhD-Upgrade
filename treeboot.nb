Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"antiPairs", "[", 
    RowBox[{"maximumIndex_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "maximumIndex"}], "]"}], ",", "2"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ">", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"symPairs", "[", 
    RowBox[{"maximumIndex_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "maximumIndex"}], "]"}], ",", "2"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ">=", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"antiPolynomial", "[", 
    RowBox[{"coefficient_", ",", "x_", ",", "xb_", ",", 
     RowBox[{"maximumIndex_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"pair", ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i", "=", 
            RowBox[{"pair", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"j", "=", 
            RowBox[{"pair", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"coefficient", "[", 
           RowBox[{"i", ",", "j"}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "^", "i"}], " ", 
             RowBox[{"xb", "^", "j"}]}], "-", 
            RowBox[{
             RowBox[{"x", "^", "j"}], " ", 
             RowBox[{"xb", "^", "i"}]}]}], ")"}]}]}], "]"}]}], "]"}], "/@", 
     RowBox[{"antiPairs", "[", "maximumIndex", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"symPolynomial", "[", 
    RowBox[{"coefficient_", ",", "x_", ",", "xb_", ",", 
     RowBox[{"maximumIndex_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"pair", ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i", "=", 
            RowBox[{"pair", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"j", "=", 
            RowBox[{"pair", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"coefficient", "[", 
           RowBox[{"i", ",", "j"}], "]"}], " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "j"}], ",", 
            RowBox[{
             RowBox[{"x", "^", "i"}], " ", 
             RowBox[{"xb", "^", "j"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "^", "i"}], " ", 
              RowBox[{"xb", "^", "j"}]}], "+", 
             RowBox[{
              RowBox[{"x", "^", "j"}], " ", 
              RowBox[{"xb", "^", "i"}]}]}]}], "]"}]}]}], "]"}]}], "]"}], "/@", 
     RowBox[{"symPairs", "[", "maximumIndex", "]"}]}], "]"}]}], 
  ";"}]}], "Input",
