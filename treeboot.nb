Cell[BoxData[
 RowBox[{
  RowBox[{"ope", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"CoefficientList", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Ftree", "[", 
            RowBox[{
             RowBox[{"s", " ", "x"}], ",", 
             RowBox[{"s", " ", "y"}]}], "]"}], "/.", 
           RowBox[{"zeroRules", "[", "7", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "0", ",", "8"}], "}"}]}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{
            SuperscriptBox["s", "2"], " ", "x", " ", "y"}], "]"}], "->", 
          "l"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "l", ",", "x", ",", "y"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.998043866097435*^9, 3.998043949949417*^9}, 
