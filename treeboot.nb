              RowBox[{"xb", "^", "j"}]}], "+", 
             RowBox[{
              RowBox[{"x", "^", "j"}], " ", 
              RowBox[{"xb", "^", "i"}]}]}]}], "]"}]}]}], "]"}]}], "]"}], "/@", 
     RowBox[{"symPairs", "[", "maximumIndex", "]"}]}], "]"}]}], 
  ";"}]}], "Input",
