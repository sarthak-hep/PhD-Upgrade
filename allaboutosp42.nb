     RowBox[{
      RowBox[{
       RowBox[{"Kgen", "[", "i", "]"}], "[", "F", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
