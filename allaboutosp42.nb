        RowBox[{"sl2Part", "[", "func", "]"}]}], ")"}], "/.", "kRule"}], "/.",
      "gaugeRules"}], "//", "gSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"gSimplify", "[", 
     RowBox[{"conf", "/.", "BosonicRule"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"A", ",", "\[Infinity]", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"B", ",", "\[Infinity]", ",", "0"}], "}"}]}], "]"}], "//", 
  "Normal"}]}], "Input",
