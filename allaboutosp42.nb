             RowBox[{
              RowBox[{"\[Theta]", "[", 
               RowBox[{"1", ",", "i"}], "]"}], "-", 
              RowBox[{"\[Theta]", "[", 
               RowBox[{"2", ",", "i"}], "]"}]}], ")"}], "**", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Theta]", "[", 
               RowBox[{"1", ",", "j"}], "]"}], "-", 
              RowBox[{"\[Theta]", "[", 
               RowBox[{"2", ",", "j"}], "]"}]}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}], ")"}]}]}], 
      ")"}]}], "//", "gDenExpand"}], "//", "gSimplify"}], "//", 
  "FullSimplify"}]], "Input",
