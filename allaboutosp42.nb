Cell["\<\
Before we act generators on G, we need to replace \[Chi] and \[Zeta] with \
their expressions in terms of t\[CloseCurlyQuote]s and y\[CloseCurlyQuote]s, \
because our generators are defined in terms of them. \
\>", "Text",
 CellChangeTimes->{{3.977056507116455*^9, 3.9770565104605503`*^9}, {
  3.9770566426392155`*^9, 
  3.977056679198532*^9}},ExpressionUUID->"50e90ff6-96ec-0644-9a0f-\
740d22655925"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newtaylor", "=", 
   RowBox[{"taylor", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Chi]", "->", 
       RowBox[{
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"t", "[", "1", "]"}], "-", 
           RowBox[{"t", "[", "2", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"t", "[", "1", "]"}], "-", 
           RowBox[{"t", "[", "3", "]"}]}], ")"}]], 
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"t", "[", "3", "]"}], "-", 
           RowBox[{"t", "[", "4", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"t", "[", "2", "]"}], "-", 
           RowBox[{"t", "[", "4", "]"}]}], ")"}]]}]}], ",", 
      RowBox[{"\[Zeta]", "->", 
       RowBox[{
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"y", "[", "1", "]"}], "-", 
           RowBox[{"y", "[", "2", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"y", "[", "1", "]"}], "-", 
           RowBox[{"y", "[", "3", "]"}]}], ")"}]], 
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"y", "[", "3", "]"}], "-", 
           RowBox[{"y", "[", "4", "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"y", "[", "2", "]"}], "-", 
           RowBox[{"y", "[", "4", "]"}]}], ")"}]]}]}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9769591028197193`*^9, 3.976959151422785*^9}, {
   3.976959249927088*^9, 3.976959300038988*^9}, 3.977055602126444*^9},
 CellLabel->"In[96]:=",ExpressionUUID->"b5a827ee-a06f-734b-adad-97ff353ed9d2"]
}, Closed]]
