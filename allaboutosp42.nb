Cell[CellGroupData[{

Cell["Conclusion", "Subsection",
 CellChangeTimes->{{3.9793968634171505`*^9, 
  3.9793968655287495`*^9}},ExpressionUUID->"11c382cd-f86b-954f-bcc1-\
5e5ad6b9ae11"],

Cell["\<\
Our two-point function clearly indicates that exchanging 1 and 2 acquires a \
minus sign, so we have to abide by fermionic contraction rule. Our FULL \
cross-ratios correctly reproduces the four-point function till all Grassmann \
order, which indicates correctness of our cross-ratios. \
\>", "Text",
 CellChangeTimes->{{3.979396866825329*^9, 
  3.979396960648279*^9}},ExpressionUUID->"a41e16a3-8a8e-5f48-8428-\
e17d786b6777"]
}, Open  ]]
}, Open  ]],

