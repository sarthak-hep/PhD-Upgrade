Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Xdiff", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Xpack", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"i", ",", "1"}], "]"}], ",", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"i", ",", "2"}], "]"}]}], "}"}], ",", 
       RowBox[{"y", "[", "i", "]"}]}], "}"}], "]"}], "-", 
    RowBox[{"Xpack", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", "[", "j", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"j", ",", "1"}], "]"}], ",", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"j", ",", "2"}], "]"}]}], "}"}], ",", 
       RowBox[{"y", "[", "j", "]"}]}], "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    FractionBox["1", 
     RowBox[{"sdet", "[", 
      RowBox[{"Xdiff", "[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]], "//", "gDenExpand"}], "//", 
   "gSimplify"}], "//", "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sdet", "[", 
     RowBox[{"sinv", "[", 
      RowBox[{"Xdiff", "[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "//", "gDenExpand"}], "//",
    "gSimplify"}], "//", "FullSimplify"}], "\[IndentingNewLine]", 
