Cell[CellGroupData[{

Cell["Check", "Subsubsection",
 CellChangeTimes->{{3.9753223060401134`*^9, 
  3.9753223065829697`*^9}},ExpressionUUID->"3ac55a66-1f23-ae41-838e-\
57d429875a66"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"X", "=", 
   RowBox[{"Xpack", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "1", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"1", ",", "1"}], "]"}], ",", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", 
      RowBox[{"y", "[", "1", "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"lhs", "=", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"gSimplify", ",", 
     RowBox[{"Xmul", "[", 
      RowBox[{
       RowBox[{"sinv", "[", "X", "]"}], ",", "X"}], "]"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}], "//", "MatrixForm"}]}], "\n", 
 RowBox[{"rhs", "=", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"gSimplify", ",", 
