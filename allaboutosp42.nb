Cell[TextData[{
 "The two point function of two ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "1"], TraditionalForm]],ExpressionUUID->
  "1cb6d7e2-be26-4c4f-a0ba-72a6c1acd2aa"],
 " operators can be written as superdeterminant of the superinverse of the \
superdistance found is last subsection, because the conformal dimension of \
these operators are 1. "
}], "Text",
 CellChangeTimes->{{3.9754371415573845`*^9, 
  3.9754372260934963`*^9}},ExpressionUUID->"9c55588c-86e1-a744-9ff5-\
0c064eb9403a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TwoPt", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"sdet", "[", 
    RowBox[{"sinv", "[", 
     RowBox[{"Xdiff", "[", 
      RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], ";"}]], "Input",
