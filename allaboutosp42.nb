          RowBox[{"{", 
           RowBox[{"\[Zeta]", ",", "n"}], "}"}]}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "maxOrder"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", 
        RowBox[{"4", "-", "m"}]}], "}"}]}], "]"}], "//", "gSimplify"}], "//", 
   "Simplify"}]}]}], "Input",
