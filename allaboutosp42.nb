a86ca5c72d67"],

Cell[CellGroupData[{

Cell["Determining the Casimir", "Chapter",
 CellChangeTimes->{{3.9725411752916965`*^9, 
  3.9725411813930855`*^9}},ExpressionUUID->"079f7d94-8816-074f-a08b-\
5c226d15fe52"],

Cell[CellGroupData[{

Cell["Definitions", "Section",
 CellChangeTimes->{{3.972388581582165*^9, 3.972388584960911*^9}, 
   3.9723888052392387`*^9},ExpressionUUID->"6083cf8c-6aa9-6342-9fa3-\
80d5602ed346"],

Cell["Treat the following section as a magic blackbox.", "Text",
 CellChangeTimes->{{3.9754368123896503`*^9, 3.9754368840108223`*^9}, {
  3.9770628265529766`*^9, 
  3.9770628411752377`*^9}},ExpressionUUID->"f3a4fbad-a7d3-a04f-8842-\
bb76e6976ae1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"--", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"setup", "--"}], "--"}], "--"}], "--"}], "--"}]}]}]}]}]}],
    "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "\[Theta]", ",", "thetaList", ",", "nTheta", ",", "bosonQ", ",", 
      "grassmannRules", ",", "gExpand", ",", "gRawSimplify", ",", 
      "indexSubsets", ",", "subsetIndex", ",", "sfZero", ",", "sfOne", ",", 
      "toSF", ",", "fromSF", ",", "gSimplify", ",", "sfMul", ",", "sfD", ",", 
      "varIndex", ",", "Dtheta", ",", "gInvEven", ",", "gDenExpand", ",", "A",
       ",", "B"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"SetAttributes", "[", 
     RowBox[{"NonCommutativeMultiply", ",", 
      RowBox[{"{", 
       RowBox[{"Flat", ",", "OneIdentity"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"i", "=", 
      RowBox[{
       RowBox[{"1", ".."}], "4", " ", "points"}]}], ",", 
     RowBox[{"a", "=", "1"}], ",", 
     RowBox[{"2", " ", "spinor", " ", "index"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nPoints", "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nSpinor", "=", "2"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"thetaList", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"i", ",", "a"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nPoints"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "1", ",", "nSpinor"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nTheta", "=", 
     RowBox[{"Length", "[", "thetaList", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "Grassmann"}]}]}]}]}], " ", "algebra", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"rules", "--"}], "--"}], "--"}], "--"}], "--"}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "nilpotency", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nilRules", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"thetaList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "**", 
         RowBox[{"thetaList", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "->", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nTheta"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"full", " ", "anticommutativity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"acRules", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"thetaList", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "**", 
          RowBox[{"thetaList", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "->", 
         RowBox[{"-", 
          RowBox[{
           RowBox[{"thetaList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "**", 
           RowBox[{"thetaList", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nTheta"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"i", "+", "1"}], ",", "nTheta"}], "}"}]}], "]"}]}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"grassmannRules", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"nilRules", ",", "acRules"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gExpand", "[", "expr_", "]"}], ":=", 
     RowBox[{"Expand", "[", 
      RowBox[{"expr", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"a_.", "**", 
           RowBox[{"(", 
            RowBox[{"b_", "+", "c_"}], ")"}]}], ":>", 
          RowBox[{
           RowBox[{"a", "**", "b"}], "+", 
           RowBox[{"a", "**", "c"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a_", "+", "b_"}], ")"}], "**", "c_."}], ":>", 
          RowBox[{
           RowBox[{"a", "**", "c"}], "+", 
           RowBox[{"b", "**", "c"}]}]}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gRawSimplify", "[", "expr_", "]"}], ":=", 
     RowBox[{"FixedPoint", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gExpand", "[", "#", "]"}], "/.", " ", "grassmannRules"}], 
         ")"}], "&"}], ",", "expr"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bosonQ", "[", "expr_", "]"}], ":=", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"expr", ",", 
       RowBox[{
        RowBox[{"Alternatives", "@@", "thetaList"}], "|", 
        "NonCommutativeMultiply"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "superfield"}]}]}]}]}], " ", "basis", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "^", "nTheta"}], ")"}], "--"}], "--"}], "--"}], 
       "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"indexSubsets", "=", 
     RowBox[{"Subsets", "[", 
      RowBox[{"Range", "[", "nTheta", "]"}], "]"}]}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"includes", " ", 
     RowBox[{"{", "}"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"subsetIndex", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{"indexSubsets", "->", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "indexSubsets", "]"}], "]"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sfZero", "[", "]"}], ":=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"Length", "[", "indexSubsets", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sfOne", "[", "]"}], ":=", 
     RowBox[{"ReplacePart", "[", 
      RowBox[{
       RowBox[{"sfZero", "[", "]"}], ",", 
       RowBox[{"1", "->", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"product", " ", "of", " ", "two", " ", "superfields", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "basis", " ", "of", " ", "subsets"}], ")"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sfMul", "[", 
      RowBox[{"c1_List", ",", "c2_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"res", "=", 
          RowBox[{"sfZero", "[", "]"}]}], ",", "s1", ",", "s2", ",", "u", ",",
          "nPairs", ",", "sign", ",", "idxU"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"c1", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "=!=", "0"}], ",", 
            RowBox[{
             RowBox[{"s1", "=", 
              RowBox[{"indexSubsets", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"c2", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "=!=", "0"}], ",", 
                 RowBox[{
