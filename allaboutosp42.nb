Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fourpt", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"gPow", "[", 
      RowBox[{"a", ",", "2"}], "]"}], "**", 
     RowBox[{"gDenExpand", "[", 
      FractionBox["1", "b"], "]"}]}], "+", 
    RowBox[{
     RowBox[{"gPow", "[", 
