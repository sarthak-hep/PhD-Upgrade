Cell[CellGroupData[{

Cell["Generators", "Section",
 CellChangeTimes->{{3.9723883546587105`*^9, 
  3.972388355949991*^9}},ExpressionUUID->"b594452a-a3a8-8d4b-b00f-\
e9f729826530"],

Cell[TextData[{
 "In this section, we construct the superconformal generators of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"osp", "(", 
    RowBox[{
     SuperscriptBox["4", "*"], "|", "2"}]}], TraditionalForm]],
  FontFamily->"Californian FB",
  FontWeight->"Normal",ExpressionUUID->"640a7a49-56d7-3343-ae47-628e61bf1243"],
 StyleBox[")",
  FontFamily->"Californian FB",
  FontWeight->"Normal"],
 " algebra suited with the representation of interest. For each case, I also \
check the correctness of the generators by applying Ward identities to \
two-point function. In my convention, all \[Theta][i, a] are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Theta]", "a"], TraditionalForm]],ExpressionUUID->
  "15fe5730-989a-ac43-87ed-2ac4b04e46c7"],
 "[i], and eps[a, b] is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", "ab"], TraditionalForm]],ExpressionUUID->
  "a3c96fdb-293b-8f40-8ef8-4ad044b01089"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9754376217487144`*^9, 3.975437627481041*^9}, {
  3.9754376823335514`*^9, 3.9754377615675507`*^9}, {3.977056825295927*^9, 
  3.9770568729113903`*^9}, {3.9770569342726784`*^9, 
  3.9770569360341606`*^9}},ExpressionUUID->"5e630306-5595-ad48-abc4-\
9dd2eb71d25c"],

Cell[CellGroupData[{

Cell["Conformal Subalgebra", "Subsection",
 CellChangeTimes->{{3.9723895230816727`*^9, 
