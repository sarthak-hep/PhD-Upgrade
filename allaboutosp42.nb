57d429875a66"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"lhs", "=", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"gSimplify", ",", 
     RowBox[{"Xmul", "[", 
      RowBox[{
       RowBox[{"sinv", "[", "X", "]"}], ",", "X"}], "]"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}], "//", "MatrixForm"}]}], "\n", 
 RowBox[{"rhs", "=", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"gSimplify", ",", 
     RowBox[{"Xmul", "[", 
      RowBox[{"X", ",", 
       RowBox[{"sinv", "[", "X", "]"}]}], "]"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}], "//", "MatrixForm"}]}]}], "Input",
