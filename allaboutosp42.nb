Cell[CellGroupData[{

Cell["Super-Casimir on First two points", "Subsection",
 CellChangeTimes->{{3.9724690824425774`*^9, 
  3.9724690934238167`*^9}},ExpressionUUID->"fb719fcf-3ae5-224f-8aa8-\
a1149da457b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "Cas2pt", ",", "sl2Part", ",", "su2RPart", ",", "su2jPart", ",", "QSPart",
      ",", "QtStPart"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sl2Part", "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{"DgenTot", "[", 
     RowBox[{"DgenTot", "[", "F", "]"}], "]"}], "-", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"PgenTot", "[", 
        RowBox[{"KgenTot", "[", "F", "]"}], "]"}], "+", 
       RowBox[{"KgenTot", "[", 
        RowBox[{"PgenTot", "[", "F", "]"}], "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"su2RPart", "[", "F_", "]"}], ":=", 
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"R0Tot", "[", 
       RowBox[{"R0Tot", "[", "F", "]"}], "]"}], "+", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"RplusTot", "[", 
          RowBox[{"RminusTot", "[", "F", "]"}], "]"}], "+", 
         RowBox[{"RminusTot", "[", 
          RowBox[{"RplusTot", "[", "F", "]"}], "]"}]}], ")"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"su2jPart", "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"LTot", "[", 
        RowBox[{"a", ",", "b"}], "]"}], "[", 
       RowBox[{
        RowBox[{"LTot", "[", 
         RowBox[{"b", ",", "a"}], "]"}], "[", "F", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b", ",", "1", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QSPart", "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"QdTot", "[", "a", "]"}], "[", 
        RowBox[{
         RowBox[{"SUTot", "[", "a", "]"}], "[", "F", "]"}], "]"}], "-", 
       RowBox[{
        RowBox[{"SUTot", "[", "a", "]"}], "[", 
        RowBox[{
         RowBox[{"QdTot", "[", "a", "]"}], "[", "F", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "1", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QtStPart", "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"QtdTot", "[", "a", "]"}], "[", 
        RowBox[{
         RowBox[{"StUTot", "[", "a", "]"}], "[", "F", "]"}], "]"}], "-", 
       RowBox[{
        RowBox[{"StUTot", "[", "a", "]"}], "[", 
        RowBox[{
         RowBox[{"QtdTot", "[", "a", "]"}], "[", "F", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "1", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cas2pt", "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{"sl2Part", "[", "F", "]"}], "-", 
