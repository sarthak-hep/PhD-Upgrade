  RowBox[{"ClearAll", "[", 
   RowBox[{"RplusTot", ",", "R0Tot", ",", "RminusTot"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RplusTot", "[", "F_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Rplus", "[", "i", "]"}], "[", "F", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"R0Tot", "[", "F_", "]"}], ":=", 
