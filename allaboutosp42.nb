Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TwoPt", "[", 
      RowBox[{"1", ",", "2"}], "]"}], "-", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"y", "[", "1", "]"}], "-", 
          RowBox[{"y", "[", "2", "]"}]}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"t", "[", "1", "]"}], "-", 
           RowBox[{"t", "[", "2", "]"}]}], ")"}], "2"]], "-", 
       RowBox[{
        FractionBox["1", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"t", "[", "1", "]"}], "-", 
            RowBox[{"t", "[", "2", "]"}]}], ")"}], "3"]], 
        RowBox[{"(", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
