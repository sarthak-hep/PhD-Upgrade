Cell[TextData[{
 "Calculate S = supertrace[Z] and Q = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"supertrace", "[", 
    SuperscriptBox["Z", "2"]}], TraditionalForm]],ExpressionUUID->
  "8e4dad09-14fb-d841-8b84-afe82d17a1d9"],
 "]. Then compute \[CapitalDelta] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"\[Sqrt]", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["S", "2"], "-", "Q"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"8a0389ce-ec87-1245-a44b-2da2cedf930b"],
 ") (while taking the square-root, we choose the branch \[Chi] > \[Zeta]). \
Super-Cross -ratios are given by (S - \[CapitalDelta]) and (S - 2\
\[CapitalDelta]), which can be seen clearly at the bosonic limit, where S = -\
\[Zeta]+2 \[Chi] and Q = ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"-", 
    SuperscriptBox["\[Zeta]", "2"]}], "+", 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Chi]", "2"]}]}]],
  CellChangeTimes->{3.976874472412697*^9, 3.976891962017277*^9, 
   3.9768969627932167`*^9, 3.9769578837017117`*^9, 3.977044246143612*^9, 
   3.977045361198616*^9, 3.9770503602697544`*^9},ExpressionUUID->
  "71c002da-a0d1-d840-9b92-25c00d8d0047"],
 ", \[CapitalDelta] = -\[Zeta]+\[Chi] resulting S - \[CapitalDelta] = \[Chi] \
and S - 2\[CapitalDelta] = \[Zeta]"
}], "Text",
 CellChangeTimes->{{3.9770519546555443`*^9, 3.977052011310753*^9}, {
  3.977055451935358*^9, 3.977055508591648*^9}, {3.977055673585705*^9, 
  3.977055788156395*^9}, {3.977055941308819*^9, 
  3.977055966138912*^9}},ExpressionUUID->"127df6bd-d555-0242-8456-\
30dac92b2897"],

