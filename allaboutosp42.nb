  RowBox[{"maxOrder", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"taylor", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{
         RowBox[{"Factorial", "[", "m", "]"}], " ", 
         RowBox[{"Factorial", "[", "n", "]"}]}]], 
       RowBox[{
        RowBox[{"gPow", "[", 
         RowBox[{"\[Delta]\[Chi]", ",", "m"}], "]"}], "**", " ", 
        RowBox[{"gPow", "[", 
         RowBox[{"\[Delta]\[Zeta]", ",", "n"}], "]"}], "**", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"G", "[", 
           RowBox[{"\[Chi]", ",", "\[Zeta]"}], "]"}], ",", 
