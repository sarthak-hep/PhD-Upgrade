Cell[CellGroupData[{

Cell["Super-Conformal Ward Identity", "Section",
 CellChangeTimes->{{3.977062240915964*^9, 
  3.9770622626604176`*^9}},ExpressionUUID->"8a234ecb-894d-e54f-8478-\
9f1d17eb475e"],

Cell[TextData[{
 "From the part of the Super-Casimir with the pole ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"\[Chi]", "-", "\[Zeta]"}]], TraditionalForm]],ExpressionUUID->
  "858f131a-d86d-b845-a588-9cf47651fcdc"],
 ", and demanding regularity at \[Chi] = \[Zeta] yields the SuperConformal \
Ward Identity: "
}], "Text",
 CellChangeTimes->{{3.977060997811289*^9, 
  3.9770610855060024`*^9}},ExpressionUUID->"8c22f460-2f2b-944a-bf9d-\
759ef204d9fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["dG", "d\[Zeta]"], "+", 
   RowBox[{
    FractionBox["1", "2"], 
    FractionBox["dG", "d\[Chi]"]}]}], " ", "=", " ", "0"}]], "DisplayFormula",
 CellChangeTimes->{{3.977061097253113*^9, 3.977061115417473*^9}, {
  3.977061211109602*^9, 
  3.9770612159622803`*^9}},ExpressionUUID->"7eb8fae7-7417-0447-89eb-\
f3c37fdc3230"],

Cell[TextData[{
 "Solution of which can be written as G[\[Chi], \[Zeta]] = a ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[Chi]", "2"], "\[Zeta]"], TraditionalForm]],
  ExpressionUUID->"1c3e35a2-fe0b-784d-bbc3-82619f1cf01b"],
 "+ (1 - \[Chi] (1 - ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Chi]", "\[Zeta]"], TraditionalForm]],ExpressionUUID->
  "d51b145f-224c-4e41-ac5c-59e9e19496a1"],
 ") ",
 Cell[BoxData[
  FormBox[
   FractionBox["d", "d\[Chi]"], TraditionalForm]],ExpressionUUID->
  "a786da80-fa1f-9641-9425-84bc7714574e"],
 ") p[\[Chi]], where a is a constant and p[\[Chi]] is an arbitrary function. \
This form is given by GPT."
}], "Text",
 CellChangeTimes->{{3.977065462618452*^9, 3.9770655502671185`*^9}, {
  3.9770656681230526`*^9, 3.9770656818199234`*^9}, {3.9770657713908386`*^9, 
  3.977065774653755*^9}, {3.977065871695032*^9, 3.977065879119236*^9}, {
  3.9770659417462025`*^9, 
  3.9770659576979065`*^9}},ExpressionUUID->"b21f8c7d-9379-8343-8cbc-\
8bc1d1cbbb5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SuperWard", "[", "G_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"G", ",", "\[Zeta]"}], "]"}], "+", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"D", "[", 
       RowBox[{"G", ",", "\[Chi]"}], "]"}]}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{
    RowBox[{"A", "[", "\[Chi]", "]"}], "+", 
    RowBox[{
     RowBox[{"B", "[", "\[Chi]", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "/", "\[Chi]"}], " ", "-", " ", 
       RowBox[{"1", "/", "\[Zeta]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"SuperWard", "[", "s", "]"}], "/.", 
    RowBox[{"\[Zeta]", "->", "\[Chi]"}]}], ")"}], "//", 
  "FullSimplify"}]}], "Input",
 CellChangeTimes->{{3.977061459228489*^9, 3.9770615020703278`*^9}, {
  3.97706184888723*^9, 3.9770618532235756`*^9}, {3.9770622804711075`*^9, 
  3.9770622933323193`*^9}, {3.9770657132780933`*^9, 3.977065763246172*^9}, {
  3.9770659733697166`*^9, 3.977065985986681*^9}, {3.977240334003788*^9, 
  3.977240338949003*^9}, {3.977240401908766*^9, 3.977240409138254*^9}, {
  3.977243420108103*^9, 3.9772434815611115`*^9}},
 CellLabel->
  "In[159]:=",ExpressionUUID->"5b3474f0-3ca8-1b43-9966-4d8a36b62710"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    FractionBox[
     RowBox[{"B", "[", "\[Chi]", "]"}], 
     SuperscriptBox["\[Chi]", "2"]], "+", 
    RowBox[{
     SuperscriptBox["A", "\[Prime]",
      MultilineFunction->None], "[", "\[Chi]", "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{
