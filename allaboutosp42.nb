     RowBox[{"(", 
      RowBox[{"1", "-", "b"}], ")"}], "**", 
     RowBox[{"gDenExpand", "[", 
      FractionBox["1", "b"], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"braid", "[", "a_", "]"}], ":=", 
   RowBox[{"a", "**", 
    RowBox[{"gDenExpand", "[", 
     FractionBox["1", 
      RowBox[{"a", "-", "1"}]], "]"}]}]}], ";"}]}], "Input",
