     RowBox[{
      RowBox[{"t", "[", "1", "]"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"t", "[", "2", "]"}], "->", "\[Chi]"}], ",", 
     RowBox[{
      RowBox[{"t", "[", "3", "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"t", "[", "4", "]"}], "->", "A"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "1", "]"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "2", "]"}], "->", "\[Zeta]"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "3", "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "4", "]"}], "->", "B"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
