Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"maxOrder", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"taylor", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{
         RowBox[{"Factorial", "[", "m", "]"}], " ", 
         RowBox[{"Factorial", "[", "n", "]"}]}]], 
       RowBox[{
        RowBox[{"gPow", "[", 
         RowBox[{"\[Delta]\[Chi]", ",", "m"}], "]"}], "**", " ", 
        RowBox[{"gPow", "[", 
         RowBox[{"\[Delta]\[Zeta]", ",", "n"}], "]"}], "**", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"G", "[", 
           RowBox[{"\[Chi]", ",", "\[Zeta]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Chi]", ",", "m"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Zeta]", ",", "n"}], "}"}]}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "maxOrder"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", 
        RowBox[{"4", "-", "m"}]}], "}"}]}], "]"}], "//", "gSimplify"}], "//", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.9769580362306633`*^9, 3.976958068408041*^9}, {
  3.9769582201543503`*^9, 3.976958245515028*^9}, {3.976958963821953*^9, 
  3.976959041977682*^9}, {3.9769591587381783`*^9, 3.976959162844185*^9}, {
  3.9769591946836586`*^9, 3.976959235856184*^9}, {3.9770581322479954`*^9, 
  3.9770581825524654`*^9}, {3.9770582170329666`*^9, 3.97705828287492*^9}, {
