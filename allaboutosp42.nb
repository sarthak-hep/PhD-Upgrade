Cell[CellGroupData[{

Cell["l = 0 : Free Theory", "Section",
 CellChangeTimes->{{3.975248165185936*^9, 3.975248168340355*^9}, {
  3.9752490206875744`*^9, 
  3.975249024972933*^9}},ExpressionUUID->"60ec5beb-4448-af4e-91e7-\
ab885344b250"],

Cell[TextData[{
 "I write down the free four-point function by taking sum of three possible \
Wick contractions. It is hereby shown that the reduced correlator becomes the \
crossing-symmetric expression in cross-ratios (1 + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SuperscriptBox["\[Chi]", "2"], "\[Zeta]"], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Chi]", "2"], "(", 
      RowBox[{"1", "-", "\[Zeta]"}], ")"}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Chi]"}], ")"}], "2"], "\[Zeta]"}]]}], 
   TraditionalForm]],ExpressionUUID->"2311c0e2-a809-6646-ba88-c93cda7129e9"],
 ") in the Bosonic limit. "
}], "Text",
 CellChangeTimes->{{3.975438396613226*^9, 
  3.9754385519300785`*^9}},ExpressionUUID->"3a9cc355-685a-3c4b-996b-\
905ba838c019"],

