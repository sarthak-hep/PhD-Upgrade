Cell["\<\
The bosonic limit of the matrix Z will give the cross-ratios of Conformal \
Subgroup and R-symmetry Subgroup in the diagonal entries, while the \
off-diagonal entries will vanish.\
\>", "Text",
 CellChangeTimes->{{3.977051750284216*^9, 
  3.9770518025144043`*^9}},ExpressionUUID->"1d8e55e1-3eae-d747-a5b5-\
1603e42bc10e"],

Cell[TextData[{
 "Superdeterminant of Z is the Superconformal Cross-ratio (analogous to ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[Chi]", "2"], 
    RowBox[{
     SubscriptBox["\[Zeta]", "1"], 
     SubscriptBox["\[Zeta]", "2"]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b6a7657d-1ddd-5b4a-aaca-41dc6784906d"],
 " in ",
 StyleBox["osp(4*|4)",
  FontFamily->"Californian FB",
  FontWeight->"Normal"],
 ")"
}], "Text",
 CellChangeTimes->{{3.9770518206682377`*^9, 
  3.977051909454975*^9}},ExpressionUUID->"0024be57-a57a-ca4d-b8e9-\
10371946cccc"],

