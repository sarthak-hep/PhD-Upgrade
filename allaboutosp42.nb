      RowBox[{"1", ",", "2"}], "]"}], "**", 
     RowBox[{"TwoPt", "[", 
      RowBox[{"3", ",", "4"}], "]"}]}], "//", "gSimplify"}]}], 
  ";"}]}], "Input",
