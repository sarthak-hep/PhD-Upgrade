  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"\[Chi]_", ",", "\[Zeta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"p", " ", 
     FractionBox[
      SuperscriptBox["\[Chi]", "2"], "\[Zeta]"]}], "+", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"f", "[", "\[Chi]", "]"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "\[Chi]"], "-", 
         FractionBox["1", "\[Zeta]"]}], ")"}], 
