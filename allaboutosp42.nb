Cell[CellGroupData[{

Cell["Two-Point Generators", "Section",
 CellChangeTimes->{{3.972389874362732*^9, 
  3.97238987873954*^9}},ExpressionUUID->"00549485-20ee-f348-bc8a-\
a5594d232fc5"],

Cell[TextData[{
 "The superblocks are eigen functions of the Casimir of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"osp", "(", 
    RowBox[{
     SuperscriptBox["4", "*"], "|", "2"}]}], TraditionalForm]],
  FontFamily->"Californian FB",
  FontWeight->"Normal",ExpressionUUID->"e3ca7b33-9c7f-a444-b507-6f3b95ef3a33"],
 StyleBox[")",
  FontFamily->"Californian FB",
  FontWeight->"Normal"],
 " acting on first two points of the four-point function. So in this section, \
I construct the generators acting on two points by just taking sum of each \
generator acting on the individual points. "
}], "Text",
 CellChangeTimes->{{3.9754377906562843`*^9, 3.9754378247709846`*^9}, {
   3.9754379541117687`*^9, 3.975438043083843*^9}, {3.9754381771736946`*^9, 
   3.975438325702732*^9}, 
   3.9770569977909317`*^9},ExpressionUUID->"1943782a-17ee-ce42-a2d7-\
1eec5f9994dc"],

