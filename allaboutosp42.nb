4bbd273a5fb9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"Pgen", ",", "Dgen", ",", "Kgen", ",", "k"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"thetaSq", "[", "i_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"eps", "[", 
       RowBox[{"a", ",", "b"}], "]"}], "**", 
      RowBox[{"\[Theta]", "[", 
       RowBox[{"i", ",", "a"}], "]"}], "**", 
      RowBox[{"\[Theta]", "[", 
       RowBox[{"i", ",", "b"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Pgen", "[", "i_", "]"}], "[", "F_", "]"}], ":=", 
   RowBox[{"D", "[", 
    RowBox[{"F", ",", 
     RowBox[{"t", "[", "i", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Dgen", "[", "i_", "]"}], "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"t", "[", "i", "]"}]}], " ", 
     RowBox[{"D", "[", 
      RowBox[{"F", ",", 
       RowBox[{"t", "[", "i", "]"}]}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"i", ",", "a"}], "]"}], "**", " ", 
        RowBox[{
         RowBox[{"Dtheta", "[", 
          RowBox[{"i", ",", "a"}], "]"}], "[", "F", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"k", "[", "i", "]"}], "**", " ", "F"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Kgen", "[", "i_", "]"}], "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"t", "[", "i", "]"}], "2"], " ", 
     RowBox[{"D", "[", 
      RowBox[{"F", ",", 
       RowBox[{"t", "[", "i", "]"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"t", "[", "i", "]"}], " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
