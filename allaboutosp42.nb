        RowBox[{"gDot", "[", 
         RowBox[{"A", ",", "B", ",", "C", ",", "..."}], "]"}]}]}]}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"A", "\[SmallCircle]", "B"}], ")"}], "\[SmallCircle]", "C"}],
        ")"}], "..."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gDot", "[", "args__", "]"}], ":=", 
     RowBox[{"Fold", "[", 
      RowBox[{"gDot2", ",", 
       RowBox[{"First", "@", 
        RowBox[{"{", "args", "}"}]}], ",", 
       RowBox[{"Rest", "@", 
        RowBox[{"{", "args", "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "gInv2NC", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"gInv2NC", "[", 
       RowBox[{"M_", "?", "MatrixQ"}], "]"}], "/;", 
      RowBox[{
       RowBox[{"Dimensions", "[", "M", "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}]}]}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", "b", ",", "c", ",", "d", ",", "ainv", ",", "dinv", ",", "S",
          ",", "Sinv", ",", "T", ",", "Tinv", ",", "TL", ",", "TR", ",", "BL",
          ",", "BR"}], "}"}], ",", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"M", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        RowBox[{"b", "=", 
         RowBox[{"M", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"c", "=", 
         RowBox[{"M", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", 
        RowBox[{"d", "=", 
         RowBox[{"M", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"--", 
           RowBox[{"--", "try"}]}], " ", "pivot", " ", "on", " ", 
          RowBox[{
           RowBox[{"a", "--"}], "--"}]}], "*)"}], 
        RowBox[{"ainv", "=", 
         RowBox[{"gDenExpand", "[", 
          RowBox[{"1", "/", "a"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ainv", "=!=", "$Failed"}], ",", 
          RowBox[{
           RowBox[{"S", "=", 
            RowBox[{"gSimplify", "[", 
             RowBox[{"d", "-", 
              RowBox[{"c", "**", "ainv", "**", "b"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Sinv", "=", 
            RowBox[{"gDenExpand", "[", 
             RowBox[{"1", "/", "S"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"Sinv", "=!=", "$Failed"}], ",", 
             RowBox[{
              RowBox[{"TL", "=", 
               RowBox[{"gSimplify", "[", 
                RowBox[{"ainv", "+", 
                 RowBox[{
                 "ainv", "**", "b", "**", "Sinv", "**", "c", "**", "ainv"}]}],
                 "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"TR", "=", 
               RowBox[{"gSimplify", "[", 
                RowBox[{"-", 
                 RowBox[{"ainv", "**", "b", "**", "Sinv"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"BL", "=", 
               RowBox[{"gSimplify", "[", 
                RowBox[{"-", 
                 RowBox[{"Sinv", "**", "c", "**", "ainv"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"BR", "=", 
               RowBox[{"gSimplify", "[", "Sinv", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Return", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"TL", ",", "TR"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"BL", ",", "BR"}], "}"}]}], "}"}], "]"}], ";"}]}], 
            "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"fallback", ":", 
            RowBox[{"pivot", " ", "on", " ", 
             RowBox[{
              RowBox[{"d", "--"}], "--"}]}]}]}]}], "*)"}], 
        RowBox[{"dinv", "=", 
         RowBox[{"gDenExpand", "[", 
          RowBox[{"1", "/", "d"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"dinv", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"T", "=", 
         RowBox[{"gSimplify", "[", 
          RowBox[{"a", "-", 
           RowBox[{"b", "**", "dinv", "**", "c"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Tinv", "=", 
         RowBox[{"gDenExpand", "[", 
          RowBox[{"1", "/", "T"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Tinv", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"TL", "=", 
         RowBox[{"gSimplify", "[", "Tinv", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"TR", "=", 
         RowBox[{"gSimplify", "[", 
          RowBox[{"-", 
           RowBox[{"Tinv", "**", "b", "**", "dinv"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"BL", "=", 
         RowBox[{"gSimplify", "[", 
          RowBox[{"-", 
           RowBox[{"dinv", "**", "c", "**", "Tinv"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"BR", "=", 
         RowBox[{"gSimplify", "[", 
          RowBox[{"dinv", "+", 
           RowBox[{
           "dinv", "**", "c", "**", "Tinv", "**", "b", "**", "dinv"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"TL", ",", "TR"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"BL", ",", "BR"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gDet", "[", "a_", "]"}], ":=", 
     RowBox[{"gSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "**", 
        RowBox[{"a", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}], "**", 
        RowBox[{"a", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "gDegreePart", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gDegreePart", "[", 
      RowBox[{"expr_", ",", "d_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sf", "=", 
          RowBox[{"toSF", "[", "expr", "]"}]}], ",", 
         RowBox[{"out", "=", 
          RowBox[{"sfZero", "[", "]"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"indexSubsets", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "==", "d"}], ",", 
            RowBox[{
             RowBox[{"out", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "=", 
             RowBox[{"sf", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "indexSubsets", "]"}]}], "}"}]}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fromSF", "[", "out", "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9723885908955097`*^9, 3.972388592119219*^9}, {
