Cell[CellGroupData[{

Cell["Cross-Ratio Calculation", "Subsection",
 CellChangeTimes->{{3.975324191291382*^9, 3.9753241943594437`*^9}, {
  3.9793995843432217`*^9, 
  3.979399588696089*^9}},ExpressionUUID->"22da28fa-10b4-e941-a05a-\
1d3dac52fa3c"],

Cell[TextData[{
 "The supermatrix Z = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "12"], 
    SuperscriptBox[
     SubscriptBox["X", "13"], 
     RowBox[{"-", "1"}]], 
    SubscriptBox["X", "34"], 
    SuperscriptBox[
     SubscriptBox["X", "24"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "dbfdff8e-f6fd-3e47-ab5b-34e784f4780f"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", 
     RowBox[{"ij", " "}]], "=", " ", 
    RowBox[{
     SubscriptBox["X", 
      RowBox[{"i", " "}]], "-", 
     SubscriptBox["X", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "82065deb-3744-734c-8172-12d34d632836"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "i"], TraditionalForm]],ExpressionUUID->
  "b5c11261-0624-0446-beca-42d33be7b05d"],
 " is the supercoordinate matrix for point i. Eigen-values of this matrix \
gives the cross-ratios for conformal and R-symmetry subalgebras (\[Chi], \
\[Zeta]) and the superdeterminant gives the superconformal cross-ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox[
     SuperscriptBox["\[Chi]", "2"], "\[Zeta]"]}], TraditionalForm]],
  ExpressionUUID->"f94c8ca0-53cc-da47-938e-ed5d36a7c136"],
 ").  The values for both mentioned in the brackets are only the bosonic \
limits i.e., after setting all theta\[CloseCurlyQuote]s to 0. In general, \
both of them have complicated but finite number of Grassmann terms. "
}], "Text",
 CellChangeTimes->{{3.975437277189535*^9, 3.9754374059047756`*^9}, {
  3.9754375059982414`*^9, 
  3.9754375983367767`*^9}},ExpressionUUID->"0bf61625-5d29-4f42-89d7-\
1440548a432e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Z", "=", 
   RowBox[{"Xmul", "[", 
    RowBox[{
     RowBox[{"Xmul", "[", 
      RowBox[{
       RowBox[{"Xmul", "[", 
        RowBox[{
         RowBox[{"Xdiff", "[", 
          RowBox[{"1", ",", "2"}], "]"}], ",", 
         RowBox[{"sinv", "[", 
          RowBox[{"Xdiff", "[", 
           RowBox[{"1", ",", "3"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"Xdiff", "[", 
        RowBox[{"3", ",", "4"}], "]"}]}], "]"}], ",", 
