      RowBox[{"Pgen", "[", "i", "]"}], "[", "F", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
