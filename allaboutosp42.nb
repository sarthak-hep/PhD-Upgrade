Cell[CellGroupData[{

Cell["R-symmetry Subalgebra", "Subsection",
 CellChangeTimes->{{3.972389556732252*^9, 
  3.972389561839161*^9}},ExpressionUUID->"0a487771-055f-cd4b-a5da-\
643535032c9d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"Rplus", ",", "R0", ",", "Rminus"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Rplus", "[", "i_", "]"}], "[", "F_", "]"}], ":=", 
   RowBox[{"D", "[", 
    RowBox[{"F", ",", 
     RowBox[{"y", "[", "i", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"R0", "[", "i_", "]"}], "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"i", ",", "a"}], "]"}], "**", " ", 
         RowBox[{
          RowBox[{"Dtheta", "[", 
           RowBox[{"i", ",", "a"}], "]"}], "[", "F", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "1", ",", "2"}], "}"}]}], "]"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"y", "[", "i", "]"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{"F", ",", 
         RowBox[{"y", "[", "i", "]"}]}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"k", "[", "i", "]"}], " ", "**", "F"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Rminus", "[", "i_", "]"}], "[", "F_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{
        RowBox[{"y", "[", "i", "]"}], "^", "2"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{"F", ",", 
         RowBox[{"y", "[", "i", "]"}]}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"thetaSq", "[", "i", "]"}], "**", " ", 
       RowBox[{"D", "[", 
        RowBox[{"F", ",", 
         RowBox[{"t", "[", "i", "]"}]}], "]"}]}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"y", "[", "i", "]"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]", "[", 
           RowBox[{"i", ",", "a"}], "]"}], "**", " ", 
          RowBox[{
           RowBox[{"Dtheta", "[", 
            RowBox[{"i", ",", "a"}], "]"}], "[", "F", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "-", 
      RowBox[{"2", " ", 
       RowBox[{"k", "[", "i", "]"}], " ", 
       RowBox[{
        RowBox[{"y", "[", "i", "]"}], " ", "**", "F"}]}]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9723892952515736`*^9, 3.9723893214708023`*^9}, {
