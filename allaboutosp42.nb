  3.9724780658460712`*^9}},ExpressionUUID->"456e31a5-2ebc-a644-81df-\
ab5d98ffbb48"],

Cell["\<\
Four-point function is in the schematic form func = Prefactor ** G[\[Chi]F, \
\[Zeta]F] = Prefactor ** (G[\[Chi], \[Zeta]] + nilpotent parts). Prefactor is \
the product of two 2-point functions TwoPt[1, 2] ** TwoPt[3, 4].  \
\>", "Text",
 CellChangeTimes->{{3.977057272878788*^9, 
  3.977057382370262*^9}},ExpressionUUID->"a54f93c7-4ad9-0b47-919a-\
75d37a92271e"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "Dist", ",", "Pref", ",", "kRule", ",", "\[Chi]", ",", "\[Zeta]", ",", "G", 
   ",", "func", ",", "gaugeRules", ",", "A", ",", "B"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "[", "1", "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"k", "[", "2", "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"k", "[", "3", "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"k", "[", "4", "]"}], "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaugeRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"t", "[", "1", "]"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"t", "[", "2", "]"}], "->", "\[Chi]"}], ",", 
     RowBox[{
      RowBox[{"t", "[", "3", "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"t", "[", "4", "]"}], "->", "A"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "1", "]"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "2", "]"}], "->", "\[Zeta]"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "3", "]"}], "->", "1"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "4", "]"}], "->", "B"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dist", "[", 
    RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"sdet", "[", 
    RowBox[{"sinv", "[", 
     RowBox[{"Xdiff", "[", 
      RowBox[{"p", ",", "q"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pref", "=", 
